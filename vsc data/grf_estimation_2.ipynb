# =========================================================
# FINAL vGRF ESTIMATION SCRIPT (CLEAN VERSION)
# =========================================================

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.io import loadmat
from pathlib import Path

# =========================================================
# 1. LOAD INPUT DATA
# =========================================================
T_contacts_left_full = pd.read_csv(
    r"D:\Projects\GRF_Estimation\vsc data\My_Left_Input_FullSteps_vsc.csv"
)

# =========================================================
# 2. LOAD REFERENCE DATA (FOR STEP 1)
# =========================================================
sup = loadmat(r"D:\GRF\SR results\grf_estimates.mat", simplify_cells=True)
left_steps = sup["trials"]["trial_01"]["forceplate"]["left"]

# =========================================================
# 3. PARAMETERS
# =========================================================
dt1 = 0.045
x_new = np.linspace(0, 100, 101)

# =========================================================
# 4. SINGLE STEP (STEP 1)
# =========================================================
i = 0

tc  = T_contacts_left_full.loc[i, "ContactTime_s"]
A1 = T_contacts_left_full.loc[i, "A1_N"]
A2 = T_contacts_left_full.loc[i, "F2avg_N"]

t = np.linspace(0, tc, 500)

# F1
B1 = dt1
C1 = dt1
F1 = np.zeros_like(t)
idx1 = (t >= 0) & (t <= 2 * dt1)
F1[idx1] = (A1 / 2) * (1 + np.cos(((t[idx1] - B1) / C1) * np.pi))

# F2
B2 = 0.38 * tc
C2L = B2
C2T = tc - B2

F2 = np.zeros_like(t)

idxL = (t >= 0) & (t <= B2)
F2[idxL] = (A2 / 2) * (1 + np.cos(((t[idxL] - B2) / C2L) * np.pi))

idxR = (t > B2) & (t <= tc)
F2[idxR] = (A2 / 2) * (1 + np.cos(((t[idxR] - B2) / C2T) * np.pi))

F2[F2 < 0] = 0

FT = F1 + F2

# Threshold
idx = np.where(FT > 40)[0]
pred_contact = FT[idx[0]:idx[-1] + 1]

# Normalize
x_old = np.linspace(0, 100, len(pred_contact))
pred_norm = np.interp(x_new, x_old, pred_contact)

# Reference step 1
F3D = np.asarray(left_steps[0]["forceplate_truth_3d"]["raw"])
Fz = F3D[:, 2]

idx_ref = np.where(Fz > 40)[0]
Fz_contact = Fz[idx_ref[0]:idx_ref[-1] + 1]

x_old_ref = np.linspace(0, 100, len(Fz_contact))
Fz_contact_norm = np.interp(x_new, x_old_ref, Fz_contact)

# RMSE
rmse = np.sqrt(np.mean((pred_norm - Fz_contact_norm) ** 2))

# =========================================================
# 5. ALL STEPS PROCESSING
# =========================================================
all_steps_data = []

for i in range(len(T_contacts_left_full)):

    tc  = T_contacts_left_full.loc[i, "ContactTime_s"]
    A1 = T_contacts_left_full.loc[i, "A1_N"]
    A2 = T_contacts_left_full.loc[i, "F2avg_N"]

    t = np.linspace(0, tc, 500)

    # F1
    F1 = np.zeros_like(t)
    idx1 = (t >= 0) & (t <= 2 * dt1)
    F1[idx1] = (A1 / 2) * (1 + np.cos(((t[idx1] - dt1) / dt1) * np.pi))

    # F2
    B2 = 0.38 * tc
    C2L = B2
    C2T = tc - B2

    F2 = np.zeros_like(t)

    idxL = (t >= 0) & (t <= B2)
    F2[idxL] = (A2 / 2) * (1 + np.cos(((t[idxL] - B2) / C2L) * np.pi))

    idxR = (t > B2) & (t <= tc)
    F2[idxR] = (A2 / 2) * (1 + np.cos(((t[idxR] - B2) / C2T) * np.pi))

    F2[F2 < 0] = 0

    FT = F1 + F2

    # threshold
    idx_pred = np.where(FT > 40)[0]
    pred_contact = FT[idx_pred[0]:idx_pred[-1] + 1]

    x_old_pred = np.linspace(0, 100, len(pred_contact))
    pred_norm_step = np.interp(x_new, x_old_pred, pred_contact)

    # reference
    if i < len(left_steps):
        F3D = np.asarray(left_steps[i]["forceplate_truth_3d"]["raw"])
        Fz = F3D[:, 2]

        idx_ref = np.where(Fz > 40)[0]
        Fz_contact = Fz[idx_ref[0]:idx_ref[-1] + 1]

        x_old_ref = np.linspace(0, 100, len(Fz_contact))
        ref_norm_step = np.interp(x_new, x_old_ref, Fz_contact)
    else:
        ref_norm_step = np.full_like(x_new, np.nan)

    # store
    for j in range(len(x_new)):
        all_steps_data.append({
            "Step": i + 1,
            "Percent_Stance": x_new[j],
            "Predicted_vGRF": pred_norm_step[j],
            "Reference_vGRF": ref_norm_step[j]
        })

T_all_steps = pd.DataFrame(all_steps_data)

# =========================================================
# 6. STEP SUMMARY
# =========================================================
summary = T_all_steps.groupby("Step")["Predicted_vGRF"].agg(["mean", "max"]).reset_index()
summary.columns = ["Step", "Mean_vGRF", "Peak_vGRF"]

# =========================================================
# 7. SAVE TO EXCEL
# =========================================================
save_path = Path(r"D:\Projects\GRF_Estimation\vsc data\GRF_Final_Output.xlsx")

T_single = pd.DataFrame({
    "Percent_Stance": x_new,
    "Predicted_vGRF": pred_norm,
    "Reference_vGRF": Fz_contact_norm
})

T_metrics = pd.DataFrame({
    "Metric": ["RMSE", "dt1", "B2"],
    "Value": [rmse, dt1, 0.38]
})

with pd.ExcelWriter(save_path, engine="openpyxl", mode="w") as writer:
    T_contacts_left_full.to_excel(writer, sheet_name="Inputs_Left", index=False)
    summary.to_excel(writer, sheet_name="Step_Summary", index=False)
    T_single.to_excel(writer, sheet_name="Single_Step", index=False)
    T_all_steps.to_excel(writer, sheet_name="All_Steps_Normalized", index=False)
    T_metrics.to_excel(writer, sheet_name="Metrics", index=False)

print("✅ Final file saved at:")
print(save_path)

# =========================================================
# 8. PLOT (OPTIONAL)
# =========================================================
plt.figure()
plt.plot(x_new, pred_norm, 'k', label='Predicted')
plt.plot(x_new, Fz_contact_norm, 'b', label='Reference')
plt.xlabel('% Stance')
plt.ylabel('Force (N)')
plt.title('Final vGRF Comparison')
plt.legend()
plt.grid(True)
plt.show()